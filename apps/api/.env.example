# TripVault API — environment variables

# Port the API listens on.
PORT=4000

# Public base URL of this API. Used to build signed file URLs for the local
# storage provider. Must be reachable by clients.
API_PUBLIC_URL=http://localhost:4000

# Allowed CORS origin (the web app).
CORS_ORIGIN=http://localhost:5173

# Supabase (required). The service-role key bypasses RLS; keep it secret.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage backend: 'local' (filesystem, dev) or 'r2' (Cloudflare R2, prod).
STORAGE_PROVIDER=local

# Required when STORAGE_PROVIDER=r2.
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=tripvault
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# Directory for the local storage provider (relative to the API working dir).
STORAGE_LOCAL_DIR=./storage

# Secret used to HMAC-sign local file URLs (required).
# Generate with: openssl rand -hex 32
FILE_SIGNING_SECRET=change-me-to-a-random-secret

# Signed URL TTLs (seconds).
DOWNLOAD_URL_TTL_SECONDS=900
UPLOAD_URL_TTL_SECONDS=3600
